{
  "appId": "com.objtoschematic.app",
  "productName": "ObjToSchematic",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "webpack/**/*",
    "package.json"
  ],
  "extraResources": [
    "res/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "res/static/icon.ico",
    "forceCodeSigning": false,
    "sign": null
  },
  "portable": {
    "artifactName": "ObjToSchematic-Portable.exe"
  }
}
